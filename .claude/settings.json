{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "//": [
    "Checked into the repo so the automation is reproducible.",
    "Personal overrides go in .claude/settings.local.json, which is gitignored.",
    "Everything here is scoped: Claude can run the tests and the ordinary git",
    "operations without asking, and nothing else. Destructive git is denied",
    "outright — deny always wins over allow."
  ],

  "permissions": {
    "allow": [
      "Bash(node tests/validate.js)",
      "Bash(node tests/dom.js)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npm install)",
      "Bash(npm ci)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(git pull --rebase:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git config core.hooksPath .githooks)",

      "Bash(gh repo view:*)",
      "Bash(gh run list:*)",
      "Bash(gh api repos/:owner/:repo/pages)"
    ],

    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git filter-branch:*)",
      "Bash(rm -rf:*)",
      "Bash(gh repo delete:*)",
      "Read(./.env)",
      "Read(./.git/config)"
    ]
  }
}
